# A wrapper library over MPFR for use with LLVM libc math unittests.

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//libc/test:libc_test_rules.bzl", "libc_test_library")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "parse_headers",
        "-use_header_modules",
        "layering_check",
    ],
)

licenses(["notice"])

cc_library(
    name = "mpfr_impl",
    hdrs = ["mpfr_inc.h"],
    target_compatible_with = select({
        "//libc:mpfr_disable": ["@platforms//:incompatible"],
        # In full build mode, the MPFR library should be built
        # using our own facilities, which is currently not possible.
        "//libc:full_build": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = select(
        {
            "//conditions:default": [],
            "//libc:mpfr_external": ["@mpfr"],
            "//libc:mpfr_system": ["//libc:libmpfr_system"],
        },
    ),
)

write_file(
    name = "mpfr_float128_stub",
    out = "mpfr_float128_stub.cpp",
    content = [
        "#include \"utils/MPFRWrapper/MPCommon.h\"",
        "",
        "#ifdef LIBC_TYPES_FLOAT128_IS_NOT_LONG_DOUBLE",
        "extern \"C\" {",
        "",
        "__attribute__((weak)) int mpfr_set_float128(mpfr_ptr r, float128 d, mpfr_rnd_t rnd) {",
        "  using FPBits = LIBC_NAMESPACE::fputil::FPBits<float128>;",
        "  FPBits bs(d);",
        "  if (bs.is_nan()) {",
        "    mpfr_set_nan(r);",
        "    return 0;",
        "  }",
        "  if (bs.is_inf()) {",
        "    mpfr_set_inf(r, bs.is_neg() ? -1 : 1);",
        "    return 0;",
        "  }",
        "  if (bs.is_zero()) {",
        "    mpfr_set_zero(r, bs.is_neg() ? -1 : 1);",
        "    return 0;",
        "  }",
        "  auto mant = bs.get_explicit_mantissa();",
        "  int exp = (bs.is_subnormal() ? -16382 : bs.get_exponent()) - FPBits::FRACTION_LEN;",
        "  uint64_t hi = static_cast<uint64_t>(mant >> 64);",
        "  uint64_t lo = static_cast<uint64_t>(mant);",
        "  mpfr_t temp;",
        "  mpfr_init2(temp, 128);",
        "  mpfr_set_ui_2exp(r, hi, exp + 64, rnd);",
        "  mpfr_set_ui_2exp(temp, lo, exp, rnd);",
        "  int inex = mpfr_add(r, r, temp, rnd);",
        "  mpfr_clear(temp);",
        "  if (bs.is_neg())",
        "    mpfr_neg(r, r, rnd);",
        "  return inex;",
        "}",
        "",
        "__attribute__((weak)) float128 mpfr_get_float128(mpfr_srcptr x, mpfr_rnd_t rnd) {",
        "  using FPBits = LIBC_NAMESPACE::fputil::FPBits<float128>;",
        "  using StorageType = typename FPBits::StorageType;",
        "  if (mpfr_nan_p(x))",
        "    return FPBits::quiet_nan().get_val();",
        "  if (mpfr_inf_p(x))",
        "    return FPBits::inf(mpfr_sgn(x) < 0 ? LIBC_NAMESPACE::Sign::NEG : LIBC_NAMESPACE::Sign::POS).get_val();",
        "  if (mpfr_zero_p(x))",
        "    return FPBits::zero(mpfr_sgn(x) < 0 ? LIBC_NAMESPACE::Sign::NEG : LIBC_NAMESPACE::Sign::POS).get_val();",
        "  mpfr_t rounded;",
        "  mpfr_init2(rounded, FPBits::FRACTION_LEN + 1);",
        "  mpfr_set(rounded, x, rnd);",
        "  mpz_t z;",
        "  mpz_init(z);",
        "  mpfr_exp_t e = mpfr_get_z_2exp(z, rounded);",
        "  bool is_neg = mpz_sgn(z) < 0;",
        "  mpz_abs(z, z);",
        "  uint64_t lo = mpz_get_ui(z);",
        "  mpz_tdiv_q_2exp(z, z, 64);",
        "  uint64_t hi = mpz_get_ui(z);",
        "  mpz_clear(z);",
        "  mpfr_clear(rounded);",
        "  StorageType mant = (static_cast<StorageType>(hi) << 64) | lo;",
        "  if (mant == 0)",
        "    return FPBits::zero(is_neg ? LIBC_NAMESPACE::Sign::NEG : LIBC_NAMESPACE::Sign::POS).get_val();",
        "  int clz = (hi != 0) ? __builtin_clzll(hi) : (64 + (lo != 0 ? __builtin_clzll(lo) : 64));",
        "  int shift = 112 - (127 - clz);",
        "  if (shift > 0) {",
        "    mant <<= shift;",
        "    e -= shift;",
        "  } else if (shift < 0) {",
        "    mant >>= -shift;",
        "    e += -shift;",
        "  }",
        "  int biased_exp = static_cast<int>(e) + 16495;",
        "  if (biased_exp >= 32767)",
        "    return FPBits::inf(is_neg ? LIBC_NAMESPACE::Sign::NEG : LIBC_NAMESPACE::Sign::POS).get_val();",
        "  if (biased_exp <= 0) {",
        "    int sub_shift = 1 - biased_exp;",
        "    if (sub_shift >= 128)",
        "      return FPBits::zero(is_neg ? LIBC_NAMESPACE::Sign::NEG : LIBC_NAMESPACE::Sign::POS).get_val();",
        "    mant >>= sub_shift;",
        "    biased_exp = 0;",
        "  }",
        "  StorageType frac = mant & ((static_cast<StorageType>(1) << FPBits::FRACTION_LEN) - 1);",
        "  StorageType raw_bits = (static_cast<StorageType>(is_neg ? 1 : 0) << (FPBits::TOTAL_LEN - 1)) |",
        "                         (static_cast<StorageType>(biased_exp) << FPBits::FRACTION_LEN) | frac;",
        "  return LIBC_NAMESPACE::cpp::bit_cast<float128>(raw_bits);",
        "}",
        "",
        "}",
        "#endif // LIBC_TYPES_FLOAT128_IS_NOT_LONG_DOUBLE",
        "",
    ],
)

libc_test_library(
    name = "mp_common",
    srcs = [
        "MPCommon.cpp",
        ":mpfr_float128_stub",
    ],
    hdrs = ["MPCommon.h"],
    features = ["-layering_check"],
    deps = [
        ":mpfr_impl",
        "//libc:__support_common",
        "//libc:__support_cpp_string",
        "//libc:__support_cpp_string_view",
        "//libc:__support_cpp_type_traits",
        "//libc:__support_fputil_bfloat16",
        "//libc:__support_fputil_cast",
        "//libc:__support_fputil_comparison_operations",
        "//libc:__support_fputil_float80",
        "//libc:__support_fputil_fp_bits",
        "//libc:__support_macros_config",
        "//libc:__support_macros_properties_types",
        "//libc:hdr_stdint_proxy",
        "//libc/test/UnitTest:fp_test_helpers",
    ],
)

libc_test_library(
    name = "mpfr_wrapper",
    srcs = ["MPFRUtils.cpp"],
    hdrs = ["MPFRUtils.h"],
    # Disable layering check when using mpfr_system.
    features = select(
        {
            "//conditions:default": [],
            "//libc:mpfr_system": ["-layering_check"],
        },
    ),
    deps = [
        ":mp_common",
        ":mpfr_impl",
        "//libc:__support_common",
        "//libc:__support_cpp_array",
        "//libc:__support_cpp_bit",
        "//libc:__support_cpp_bitset",
        "//libc:__support_cpp_string",
        "//libc:__support_cpp_string_view",
        "//libc:__support_cpp_stringstream",
        "//libc:__support_cpp_type_traits",
        "//libc:__support_fputil_bfloat16",
        "//libc:__support_fputil_cast",
        "//libc:__support_fputil_fp_bits",
        "//libc:__support_fputil_fpbits_str",
        "//libc:__support_macros_config",
        "//libc:__support_macros_properties_types",
        "//libc:hdr_math_macros",
        "//libc:hdr_stdint_proxy",
        "//libc/test/UnitTest:LibcUnitTest",
        "//libc/test/UnitTest:fp_test_helpers",
    ],
)
